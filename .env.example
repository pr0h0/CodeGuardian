AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CODEGUARDIAN_DB_PATH=.codeguardian/codeguardian.sqlite
CODEGUARDIAN_REPORT_DIR=codeguardian-report
CODEGUARDIAN_DEFAULT_TARGET=http://localhost:3000
CODEGUARDIAN_ALLOW_HOSTS=localhost,127.0.0.1
CODEGUARDIAN_REQUIRE_APPROVAL=true
CODEGUARDIAN_MAX_FILE_SIZE=1048576
CODEGUARDIAN_MAX_CONTEXT_CHARS=60000
CODEGUARDIAN_MAX_AI_FINDINGS=25
CODEGUARDIAN_MAX_AI_FINDINGS_LIMIT=1000
CODEGUARDIAN_AI_AUDIT=true
CODEGUARDIAN_AI_AUDIT_MAX_FILES=40
CODEGUARDIAN_AI_AUDIT_MAX_ROUNDS=6
CODEGUARDIAN_AI_AUDIT_MAX_CHARS=160000
CODEGUARDIAN_REDACT_SECRETS=true
